@page
@model IndexModel
@{
    ViewData["Title"] = "Upcoming events";
}

<section class="intro">
    <p class="eyebrow">Campus events</p>
    <h1>Discover campus events</h1>
    <p class="lead">Browse upcoming student organization events, register online, and receive your digital QR ticket.</p>
    <p class="intro-note">Registration stays open while seats remain.</p>
</section>

<section class="section-block">
    <div class="section-heading">
        <h2>Upcoming events</h2>
        <p>@Model.UpcomingEvents.Count scheduled</p>
    </div>

    @if (Model.UpcomingEvents.Count == 0)
    {
        <p class="empty-state">No events scheduled right now. Check back soon!</p>
    }
    else
    {
        <div class="event-list">
            @foreach (var ev in Model.UpcomingEvents)
            {
                <article class="event-card">
                    <div class="event-card-top">
                        <span class="sample-tag">Campus event</span>
                        <span class="capacity">@ev.Capacity seats</span>
                    </div>
                    <h2>@ev.Name</h2>
                    <dl class="event-meta">
                        <div>
                            <dt>Date</dt>
                            <dd>@ev.EventDate.ToString("MMMM d, yyyy  h:mm tt")</dd>
                        </div>
                        <div>
                            <dt>Venue</dt>
                            <dd>@ev.Venue</dd>
                        </div>
                    </dl>
                    <p>@ev.Description</p>
                    <a asp-page="/Registration/Register" asp-route-eventId="@ev.EventId" class="button primary">Register now</a>
                </article>
            }
        </div>
    }
</section>
