@page "/Scan"
@model Evently.Web.Pages.CheckIn.ScanModel
@{
    ViewData["Title"] = "QR door scanner";
}

<section class="scan-page">
    <p class="eyebrow">Staff QR scanner</p>
    <h1>Door check-in &amp; scanner</h1>
    <p class="scan-guidance">Scan an attendee QR ticket or enter the ticket ID manually.</p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="scan-result success" role="status">
            <strong>Success</strong>
            <span>@Model.SuccessMessage</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="scan-result danger" role="alert">
            <strong>Invalid ticket</strong>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form method="post" class="form-card">
        <div class="field">
            <label for="ticketId">Ticket ID (scan / enter)</label>
            <input type="text" id="ticketId" name="TicketId" value="@Model.TicketId" placeholder="e.g. 11111111-0001-4000-8000-000000000001" autofocus required />
        </div>

        <button type="submit" name="Action" value="checkin" class="button primary full">Check in (entry)</button>
        <button type="submit" name="Action" value="checkout" class="button secondary full">Check out (exit)</button>
    </form>
</section>
