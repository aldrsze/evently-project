<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Evently</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <a class="wordmark" asp-page="/Index" aria-label="Evently home">
            <span class="mark" aria-hidden="true">E</span>
            <span>Evently</span>
        </a>
        <nav aria-label="Main navigation">
            <a asp-page="/Registration/Register">Guest registration</a>
            @if (Context.Request.Path.StartsWithSegments("/Scan"))
            {
                <a asp-page="/CheckIn/Scan">Scanner</a>
            }
            else
            {
                <a asp-page="/Auth/Login">Sign in</a>
            }
        </nav>
    </header>

    <main id="main" class="page-wrap">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>Evently · Event registration and attendance</span>
        <span>Campus events · Digital QR tickets</span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
