<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Evently</title>
    <link rel="icon" type="image/svg+xml" href="~/images/evently-logo.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <a class="wordmark" asp-page="/Index" aria-label="Evently home">
            <span>Evently</span>
        </a>
        <nav aria-label="Main navigation">
            <a asp-page="/Registration/Register">Guest registration</a>
            <a asp-page="/Tickets/FindTicket">Find ticket</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/CheckIn/Scan">Scanner</a>
                <details class="user-menu">
                    <summary class="user-badge">@User.Identity.Name</summary>
                    <div class="user-dropdown">
                        <a asp-page="/Auth/Logout">Sign out</a>
                    </div>
                </details>
            }
            else
            {
                <a asp-page="/Auth/Login">Sign in</a>
            }
        </nav>
    </header>

    <main id="main" class="page-wrap">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>Evently — Event registration and attendance</span>
        <span>Digital QR tickets</span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
