@page "/Login"
@model Evently.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Staff login";
}

<section class="narrow-page">
    <a class="back-link" asp-page="/Index">← Upcoming events</a>
    <p class="eyebrow">Staff access</p>
    <h1>Staff login</h1>
    <p class="lead">Sign in with your staff account to access the door scanner.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-panel" role="alert">
            <p>@Model.ErrorMessage</p>
        </div>
    }

    <form method="post" class="form-card">
        <div class="field">
            <label for="username">Username</label>
            <input type="text" id="username" name="Username" value="@Model.Username" required autocomplete="username" />
        </div>

        <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="Password" required autocomplete="current-password" />
        </div>

        <button type="submit" class="button primary full">Sign in</button>
    </form>
</section>
